include_guard(GLOBAL)
get_filename_component(ADK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(NOT ADK_TARGET MATCHES "^(windows|linux|ps5)$")
    message(FATAL_ERROR "Use an AnyDevKit target toolchain")
endif()
if(NOT ADK_DEPENDENCY_ROOT OR NOT IS_DIRECTORY "${ADK_DEPENDENCY_ROOT}")
    message(FATAL_ERROR "Set ADK_DEPENDENCY_ROOT to installed release dependencies; adk setup is not implemented")
endif()
get_filename_component(adkDependencyParent "${ADK_DEPENDENCY_ROOT}" DIRECTORY)
set(ADK_HEADERS "${adkDependencyParent}/include/anyps5" CACHE PATH "AnyPS5 public release headers")
if(NOT EXISTS "${ADK_HEADERS}/prx/libc/libc.hpp")
    message(FATAL_ERROR "Missing AnyPS5 release headers: ${ADK_HEADERS}")
endif()
if(CMAKE_HOST_WIN32)
    set(ADK_EXECUTABLE "${ADK_ROOT}/bin/adk.exe")
else()
    set(ADK_EXECUTABLE "${ADK_ROOT}/bin/adk")
endif()
if(NOT EXISTS "${ADK_EXECUTABLE}")
    message(FATAL_ERROR "Missing SDK executable: ${ADK_EXECUTABLE}")
endif()
find_package(AnyLibcxx CONFIG REQUIRED PATHS "${ADK_DEPENDENCY_ROOT}/anycxx/lib/cmake/AnyLibcxx" NO_DEFAULT_PATH)
if(ADK_TARGET STREQUAL "linux")
    enable_language(ASM)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/Application.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Shaders.cmake")
