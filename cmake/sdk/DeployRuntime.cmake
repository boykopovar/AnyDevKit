cmake_minimum_required(VERSION 3.22.1)

if(NOT IS_DIRECTORY "${RUNTIME_DIRECTORY}" OR NOT IS_DIRECTORY "${OUTPUT_DIRECTORY}" OR NOT EXISTS "${EXECUTABLE}")
    message(FATAL_ERROR "Missing runtime or executable")
endif()
if(NOT TARGET_PLATFORM MATCHES "^(windows|linux)$" OR NOT EXISTS "${READOBJ}")
    message(FATAL_ERROR "Missing runtime inspection tool or target platform")
endif()
file(REAL_PATH "${RUNTIME_DIRECTORY}" runtime)
file(REAL_PATH "${OUTPUT_DIRECTORY}" output)
if(runtime STREQUAL output OR runtime STREQUAL "${output}/libs")
    message(FATAL_ERROR "Runtime source must be separate from application output")
endif()
if(EXISTS "${output}/libs")
    file(REAL_PATH "${output}/libs" deployed)
    if(NOT deployed STREQUAL "${output}/libs")
        message(FATAL_ERROR "Runtime output must not redirect outside the application")
    endif()
endif()
file(GLOB available RELATIVE "${runtime}" "${runtime}/*.prx" "${runtime}/*.dll" "${runtime}/*.so" "${runtime}/*.so.*")
set(keys)
foreach(module IN LISTS available)
    if(NOT module MATCHES "^[A-Za-z0-9_.+-]+$")
        message(FATAL_ERROR "Invalid runtime filename: ${module}")
    endif()
    set(key "${module}")
    if(TARGET_PLATFORM STREQUAL "windows")
        string(TOLOWER "${key}" key)
    endif()
    if(key IN_LIST keys)
        message(FATAL_ERROR "Ambiguous runtime filename: ${module}")
    endif()
    list(APPEND keys "${key}")
endforeach()
set(pending "${EXECUTABLE}")
set(selected)
foreach(module IN LISTS EXTRA_LIBRARIES)
    if(NOT module IN_LIST available)
        message(FATAL_ERROR "Missing explicit runtime module: ${module}")
    endif()
    list(APPEND selected "${module}")
    list(APPEND pending "${runtime}/${module}")
endforeach()
set(visited)
while(pending)
    list(POP_FRONT pending binary)
    if(binary IN_LIST visited)
        continue()
    endif()
    list(APPEND visited "${binary}")
    set(inspectOptions --needed-libs)
    if(TARGET_PLATFORM STREQUAL "windows")
        list(APPEND inspectOptions --coff-imports)
    endif()
    execute_process(COMMAND "${READOBJ}" ${inspectOptions} "${binary}" OUTPUT_VARIABLE inspection COMMAND_ERROR_IS_FATAL ANY)
    if(TARGET_PLATFORM STREQUAL "windows" AND NOT inspection MATCHES "Format: COFF-x86-64")
        message(FATAL_ERROR "Runtime is not Windows x86-64: ${binary}")
    endif()
    if(TARGET_PLATFORM STREQUAL "linux" AND NOT inspection MATCHES "Format: elf64-x86-64")
        message(FATAL_ERROR "Runtime is not Linux x86-64: ${binary}")
    endif()
    if(NOT inspection MATCHES [=[NeededLibraries \[([^]]*)\]]=])
        message(FATAL_ERROR "Cannot inspect runtime dependencies: ${binary}")
    endif()
    set(imports "${CMAKE_MATCH_1}")
    string(REPLACE "\r" "" imports "${imports}")
    string(REPLACE "\n" ";" imports "${imports}")
    if(TARGET_PLATFORM STREQUAL "windows")
        string(REGEX MATCHALL [=[DelayImport \{[^}]*\}]=] delayed "${inspection}")
        foreach(entry IN LISTS delayed)
            if(NOT entry MATCHES "Name: ([^\r\n]+)")
                message(FATAL_ERROR "Cannot inspect delayed import: ${binary}")
            endif()
            list(APPEND imports "${CMAKE_MATCH_1}")
        endforeach()
    endif()
    foreach(import IN LISTS imports)
        string(STRIP "${import}" import)
        if(import STREQUAL "")
            continue()
        endif()
        if(NOT import MATCHES "^[A-Za-z0-9_.+-]+$")
            message(FATAL_ERROR "Unsupported runtime dependency: ${binary}: ${import}")
        endif()
        set(key "${import}")
        if(TARGET_PLATFORM STREQUAL "windows")
            string(TOLOWER "${key}" key)
        endif()
        list(FIND keys "${key}" index)
        if(index EQUAL -1)
            if(key MATCHES "[.]prx$")
                message(FATAL_ERROR "Missing runtime dependency: ${binary}: ${import}")
            endif()
            continue()
        endif()
        list(GET available ${index} module)
        list(APPEND selected "${module}")
        list(APPEND pending "${runtime}/${module}")
    endforeach()
endwhile()
list(REMOVE_DUPLICATES selected)
list(SORT selected)
file(MAKE_DIRECTORY "${output}/libs")
foreach(module IN LISTS selected)
    file(COPY_FILE "${runtime}/${module}" "${output}/libs/${module}" ONLY_IF_DIFFERENT)
endforeach()
file(GLOB deployed RELATIVE "${output}/libs" "${output}/libs/*.prx" "${output}/libs/*.dll" "${output}/libs/*.so" "${output}/libs/*.so.*")
foreach(module IN LISTS deployed)
    if(NOT module IN_LIST selected)
        file(REMOVE "${output}/libs/${module}")
    endif()
endforeach()
foreach(module IN LISTS available)
    if(EXISTS "${output}/${module}")
        if(IS_DIRECTORY "${output}/${module}")
            message(FATAL_ERROR "Unexpected legacy runtime path: ${output}/${module}")
        endif()
        file(REMOVE "${output}/${module}")
    endif()
endforeach()
if(IS_DIRECTORY "${runtime}/licenses")
    file(COPY "${runtime}/licenses" DESTINATION "${output}/libs")
endif()
if(TARGET_PLATFORM STREQUAL "windows")
    set(manifest "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<assembly xmlns=\"urn:schemas-microsoft-com:asm.v1\" manifestVersion=\"1.0\">\n<assemblyIdentity type=\"win32\" name=\"libs\" version=\"1.0.0.0\" processorArchitecture=\"amd64\"/>\n")
    foreach(module IN LISTS selected)
        string(APPEND manifest "<file name=\"${module}\"/>\n")
    endforeach()
    string(APPEND manifest "</assembly>\n")
    file(WRITE "${output}/libs/libs.manifest" "${manifest}")
endif()
list(LENGTH selected count)
message(STATUS "Deployed ${count} runtime libraries")

