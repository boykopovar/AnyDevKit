cmake_minimum_required(VERSION 3.22.1)

if(NOT IS_DIRECTORY "${RUNTIME_DIRECTORY}" OR NOT IS_DIRECTORY "${OUTPUT_DIRECTORY}")
    message(FATAL_ERROR "Missing runtime or executable directory")
endif()
file(REAL_PATH "${RUNTIME_DIRECTORY}" runtime)
file(REAL_PATH "${OUTPUT_DIRECTORY}" output)
if(runtime STREQUAL output OR runtime STREQUAL "${output}/libs")
    message(FATAL_ERROR "Runtime source must be separate from application output")
endif()
file(COPY "${runtime}/" DESTINATION "${output}/libs")
file(GLOB modules RELATIVE "${runtime}" "${runtime}/*.prx" "${runtime}/*.dll" "${runtime}/*.so" "${runtime}/*.so.*")
foreach(module IN LISTS modules)
    if(EXISTS "${output}/${module}")
        if(IS_DIRECTORY "${output}/${module}")
            message(FATAL_ERROR "Unexpected legacy runtime path: ${output}/${module}")
        endif()
        file(REMOVE "${output}/${module}")
    endif()
endforeach()
