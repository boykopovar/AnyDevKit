function(adk_windows_runtime_manifest target)
    find_program(ADK_RC NAMES llvm-rc REQUIRED)
    set(identity "<assemblyIdentity type=\"win32\" name=\"libs\" version=\"1.0.0.0\" processorArchitecture=\"amd64\"/>")
    set(manifest "${CMAKE_CURRENT_BINARY_DIR}/${target}.manifest")
    file(CONFIGURE OUTPUT "${manifest}" CONTENT "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<assembly xmlns=\"urn:schemas-microsoft-com:asm.v1\" manifestVersion=\"1.0\">\n<dependency><dependentAssembly>${identity}</dependentAssembly></dependency>\n</assembly>\n" @ONLY)
    set(resource "${CMAKE_CURRENT_BINARY_DIR}/${target}-manifest.rc")
    set(object "${CMAKE_CURRENT_BINARY_DIR}/${target}-manifest.res")
    file(CONFIGURE OUTPUT "${resource}" CONTENT "1 24 \"${manifest}\"\n" @ONLY)
    add_custom_command(OUTPUT "${object}" COMMAND "${ADK_RC}" /FO "${object}" "${resource}" DEPENDS "${resource}" "${manifest}" VERBATIM)
    set_source_files_properties("${object}" PROPERTIES GENERATED TRUE EXTERNAL_OBJECT TRUE)
    target_sources(${target} PRIVATE "${object}")
endfunction()
