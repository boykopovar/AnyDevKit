function(adk_add_shaders target)
    cmake_parse_arguments(SHADER "" "STAGE;ENTRY;ADDRESS32_HI;PRIMITIVE_TYPE;SAMPLES;COLOR_FORMAT" "INCLUDE_DIRECTORIES;OPTIONS" ${ARGN})
    foreach(source IN LISTS SHADER_UNPARSED_ARGUMENTS)
        get_filename_component(input "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        get_filename_component(extension "${source}" LAST_EXT)
        if(SHADER_STAGE)
            set(stage "${SHADER_STAGE}")
        elseif(extension STREQUAL ".vert")
            set(stage vertex)
        elseif(extension STREQUAL ".comp")
            set(stage compute)
        elseif(extension STREQUAL ".frag")
            set(stage fragment)
        else()
            message(FATAL_ERROR "Specify STAGE for shader ${source}")
        endif()
        string(SHA256 identity "${input};${ARGN}")
        string(SUBSTRING "${identity}" 0 16 identity)
        get_filename_component(name "${source}" NAME)
        set(directory "${CMAKE_CURRENT_BINARY_DIR}/shaders/${name}-${identity}")
        set(options)
        foreach(option ENTRY ADDRESS32_HI PRIMITIVE_TYPE SAMPLES COLOR_FORMAT)
            if(DEFINED SHADER_${option})
                string(TOLOWER "${option}" key)
                string(REPLACE "_" "-" key "${key}")
                list(APPEND options "--${key}" "${SHADER_${option}}")
            endif()
        endforeach()
        set(dependencies "${input}")
        foreach(include IN LISTS SHADER_INCLUDE_DIRECTORIES)
            get_filename_component(include "${include}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
            list(APPEND options --include "${include}")
            file(GLOB_RECURSE headers CONFIGURE_DEPENDS "${include}/*")
            list(APPEND dependencies ${headers})
        endforeach()
        add_custom_command(OUTPUT "${directory}/header.bin" "${directory}/code.bin" "${directory}/bindings.adk"
            COMMAND "${CMAKE_COMMAND}" "-DADK=${ADK_EXECUTABLE}" "-DINPUT=${input}" "-DDIRECTORY=${directory}" "-DSTAGE=${stage}" "-DOPTIONS=${options};${SHADER_OPTIONS}" -P "${ADK_ROOT}/lib/cmake/AnyDevKit/Shader.cmake"
            DEPENDS ${dependencies} "${ADK_EXECUTABLE}"
            VERBATIM)
        add_custom_target(${target}Shader_${identity} DEPENDS "${directory}/header.bin" "${directory}/code.bin" "${directory}/bindings.adk")
        add_dependencies(${target} ${target}Shader_${identity})
        set_property(TARGET ${target} APPEND PROPERTY ADK_SHADER_DIRECTORIES "${directory}")
    endforeach()
endfunction()

function(adk_add_shader_pipeline target name)
    cmake_parse_arguments(PIPELINE "" "VERTEX;GEOMETRY;CONTROL;EVALUATION" "INCLUDE_DIRECTORIES;OPTIONS" ${ARGN})
    if(PIPELINE_UNPARSED_ARGUMENTS OR NOT PIPELINE_VERTEX OR NOT name MATCHES "^[A-Za-z0-9_]+$")
        message(FATAL_ERROR "Expected a pipeline name and VERTEX source")
    endif()
    set(options)
    set(dependencies)
    foreach(stage VERTEX GEOMETRY CONTROL EVALUATION)
        if(PIPELINE_${stage})
            get_filename_component(input "${PIPELINE_${stage}}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
            string(TOLOWER "${stage}" key)
            list(APPEND options "--${key}" "${input}")
            list(APPEND dependencies "${input}")
        endif()
    endforeach()
    foreach(include IN LISTS PIPELINE_INCLUDE_DIRECTORIES)
        get_filename_component(include "${include}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        list(APPEND options --include "${include}")
        file(GLOB_RECURSE headers CONFIGURE_DEPENDS "${include}/*")
        list(APPEND dependencies ${headers})
    endforeach()
    set(directory "${CMAKE_CURRENT_BINARY_DIR}/shaders/${name}")
    if(PIPELINE_GEOMETRY)
        if(PIPELINE_CONTROL OR PIPELINE_EVALUATION)
            message(FATAL_ERROR "Geometry and tessellation pipelines must be separate")
        endif()
        set(stages geometry)
    elseif(PIPELINE_CONTROL AND PIPELINE_EVALUATION)
        set(stages control evaluation)
    else()
        message(FATAL_ERROR "Expected GEOMETRY or CONTROL + EVALUATION")
    endif()
    set(outputs)
    foreach(stage IN LISTS stages)
        foreach(extension header code adk)
            list(APPEND outputs "${directory}/${stage}.${extension}")
        endforeach()
    endforeach()
    add_custom_command(OUTPUT ${outputs}
        COMMAND "${CMAKE_COMMAND}" "-DADK=${ADK_EXECUTABLE}" "-DDIRECTORY=${directory}" "-DOPTIONS=${options};${PIPELINE_OPTIONS}" "-DSTAGES=${stages}" -P "${ADK_ROOT}/lib/cmake/AnyDevKit/ShaderPipeline.cmake"
        DEPENDS ${dependencies} "${ADK_EXECUTABLE}"
        VERBATIM)
    add_custom_target(${target}Pipeline_${name} DEPENDS ${outputs})
    add_dependencies(${target} ${target}Pipeline_${name})
    set_property(TARGET ${target} APPEND PROPERTY ADK_SHADER_DIRECTORIES "${directory}")
endfunction()
