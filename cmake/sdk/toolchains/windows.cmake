set(ADK_TARGET windows)
set(ANYLIBCXX_TARGET windows)
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT ADK_SYSROOT OR NOT IS_DIRECTORY "${ADK_SYSROOT}/include")
    message(FATAL_ERROR "ADK_SYSROOT must contain MinGW headers")
endif()
set(CMAKE_SYSROOT "${ADK_SYSROOT}")
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET x86_64-w64-windows-gnu)
set(CMAKE_CXX_COMPILER_TARGET x86_64-w64-windows-gnu)
set(CMAKE_CXX_FLAGS_INIT "-fdwarf-exceptions -fno-stack-protector -fno-stack-check -mno-stack-arg-probe")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ADK_SYSROOT)
