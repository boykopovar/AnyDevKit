set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT ADK_SYSROOT OR NOT IS_DIRECTORY "${ADK_SYSROOT}/usr/include")
    message(FATAL_ERROR "ADK_SYSROOT must contain the target C headers")
endif()
set(CMAKE_SYSROOT "${ADK_SYSROOT}")
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_ASM_COMPILER clang)
set(CMAKE_C_COMPILER_TARGET x86_64-unknown-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET x86_64-unknown-linux-gnu)
set(CMAKE_ASM_COMPILER_TARGET x86_64-unknown-linux-gnu)
set(CMAKE_C_FLAGS_INIT "-fPIC -fno-stack-protector -isystem \"${ADK_SYSROOT}/usr/include/x86_64-linux-gnu\"")
set(CMAKE_CXX_FLAGS_INIT "-fPIC -fno-stack-protector -isystem \"${ADK_SYSROOT}/usr/include/x86_64-linux-gnu\"")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ADK_SYSROOT)
