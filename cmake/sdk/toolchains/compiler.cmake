set(ADK_COMPILER clang CACHE STRING "Application compiler: clang or gcc")
set_property(CACHE ADK_COMPILER PROPERTY STRINGS clang gcc)
if(ADK_COMPILER STREQUAL "clang")
    set(CMAKE_C_COMPILER clang)
    set(CMAKE_CXX_COMPILER clang++)
    set(CMAKE_ASM_COMPILER clang)
elseif(ADK_COMPILER STREQUAL "gcc")
    set(CMAKE_C_COMPILER gcc)
    set(CMAKE_CXX_COMPILER g++)
    set(CMAKE_ASM_COMPILER gcc)
else()
    message(FATAL_ERROR "ADK_COMPILER must be clang or gcc")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ADK_COMPILER)

