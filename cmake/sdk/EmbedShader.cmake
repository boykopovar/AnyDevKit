file(STRINGS "${DIRECTORY}/bindings.adk" fields)
list(POP_FRONT fields version)
if(NOT version STREQUAL "adk-psbc-metadata-v1")
    message(FATAL_ERROR "Unsupported shader metadata")
endif()
foreach(field IN LISTS fields)
    if(NOT field MATCHES "^([^=]+)=([0-9]+)$")
        message(FATAL_ERROR "Invalid shader metadata field: ${field}")
    endif()
    set(key "${CMAKE_MATCH_1}")
    set(value "${CMAKE_MATCH_2}")
    if(DEFINED metadata_${key})
        message(FATAL_ERROR "Duplicate shader metadata field: ${key}")
    endif()
    set(metadata_${key} "${value}")
endforeach()
foreach(key user_sgpr_count push_constants_valid push_constants_user_data_dword push_constant_size ngg_lds_layout_valid ngg_lds_layout_user_data_dword ngg_lds_layout descriptor_binding_count vertex_buffer_table_valid view_index_valid draw_id_valid start_instance_valid)
    if(NOT DEFINED metadata_${key})
        message(FATAL_ERROR "Missing shader metadata field: ${key}")
    endif()
endforeach()
foreach(key vertex_buffer_table_valid view_index_valid draw_id_valid start_instance_valid)
    if(NOT metadata_${key} EQUAL 0)
        message(FATAL_ERROR "Embedded shader requires unsupported resource: ${key}")
    endif()
endforeach()
if(metadata_user_sgpr_count GREATER 16)
    message(FATAL_ERROR "Embedded shader user data exceeds 16 registers")
endif()
foreach(index RANGE 0 15)
    set(userData_${index} 0)
endforeach()
if(metadata_ngg_lds_layout_valid)
    if(metadata_ngg_lds_layout_user_data_dword GREATER_EQUAL metadata_user_sgpr_count)
        message(FATAL_ERROR "Invalid NGG user data slot")
    endif()
    set(userData_${metadata_ngg_lds_layout_user_data_dword} "${metadata_ngg_lds_layout}")
endif()
set(slot -1)
if(metadata_push_constants_valid)
    set(slot "${metadata_push_constants_user_data_dword}")
    if(slot GREATER_EQUAL metadata_user_sgpr_count)
        message(FATAL_ERROR "Invalid push constant user data slot")
    endif()
endif()
string(TOUPPER "${SYMBOL}" guard)
set(text "#ifndef ADK_GENERATED_${guard}_HPP\n#define ADK_GENERATED_${guard}_HPP\n#include <array>\n#include <cstdint>\nnamespace AdkShaders::${SYMBOL} {\n")
foreach(kind Header Code)
    string(TOLOWER "${kind}" filename)
    file(READ "${DIRECTORY}/${filename}.bin" bytes HEX)
    if(NOT bytes)
        message(FATAL_ERROR "Empty shader ${kind}")
    endif()
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
    string(APPEND text "inline constexpr std::uint8_t ${kind}[]{${bytes}};\n")
endforeach()
set(values)
foreach(index RANGE 0 15)
    list(APPEND values "${userData_${index}}")
endforeach()
list(JOIN values "," values)
set(descriptorSlots)
foreach(index RANGE 0 3)
    set(valid "metadata_descriptor_set_valid[${index}]")
    set(slotKey "metadata_descriptor_set_user_data_dword[${index}]")
    if(NOT DEFINED "${valid}" OR NOT DEFINED "${slotKey}")
        message(FATAL_ERROR "Missing descriptor set metadata")
    endif()
    if(${valid})
        set(descriptorSlot "${${slotKey}}")
        if(descriptorSlot GREATER_EQUAL metadata_user_sgpr_count)
            message(FATAL_ERROR "Invalid descriptor set user data slot")
        endif()
        list(APPEND descriptorSlots "${descriptorSlot}")
    else()
        list(APPEND descriptorSlots -1)
    endif()
endforeach()
list(JOIN descriptorSlots "," descriptorSlots)
string(APPEND text "inline constexpr std::array<int, 4> DescriptorSetSlots{${descriptorSlots}};\n")
string(APPEND text "inline constexpr std::array<std::uint32_t, 16> UserData{${values}};\ninline constexpr std::uint32_t UserDataCount = ${metadata_user_sgpr_count};\ninline constexpr int PushConstantSlot = ${slot};\ninline constexpr std::uint32_t PushConstantSize = ${metadata_push_constant_size};\n}\n#endif\n")
get_filename_component(parent "${HEADER}" DIRECTORY)
file(MAKE_DIRECTORY "${parent}")
file(WRITE "${HEADER}" "${text}")

