include("${CMAKE_CURRENT_LIST_DIR}/DesktopRuntime.cmake")

function(adk_add_executable target)
    add_executable(${target} ${ARGN})
    target_compile_features(${target} PRIVATE cxx_std_20)
    set_target_properties(${target} PROPERTIES CXX_EXTENSIONS OFF)
    target_include_directories(${target} SYSTEM PRIVATE "${ADK_HEADERS}")
    target_link_libraries(${target} PRIVATE AnyLibcxx::Runtime)
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Werror -fno-builtin -fno-stack-protector -fvisibility=hidden)
    target_link_options(${target} PRIVATE -nostdlib -fuse-ld=lld)
    if(ADK_TARGET STREQUAL "ps5")
        set_target_properties(${target} PROPERTIES SUFFIX .elf)
        target_compile_options(${target} PRIVATE -fPIC)
        target_link_options(${target} PRIVATE -shared "-Wl,--entry=main,--hash-style=sysv,--eh-frame-hdr,--no-undefined,-z,max-page-size=16384")
    else()
        set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${PROJECT_SOURCE_DIR}/dist/${ADK_TARGET}")
        find_program(ADK_READOBJ NAMES llvm-readobj REQUIRED)
        if(ADK_TARGET STREQUAL "windows")
            adk_windows_runtime_manifest(${target})
            set(startup "${ADK_ROOT}/lib/libAnyDevKitWindowsStartup.a")
            if(NOT EXISTS "${startup}")
                message(FATAL_ERROR "Missing SDK Windows startup library: ${startup}")
            endif()
            target_link_libraries(${target} PRIVATE "${startup}")
            set(thunk "${CMAKE_CURRENT_BINARY_DIR}/${target}-startup.obj")
            add_custom_command(OUTPUT "${thunk}" COMMAND "${CMAKE_COMMAND}" -E rm -f "${thunk}" COMMAND "${ADK_EXECUTABLE}" windows-startup --output "${thunk}" DEPENDS "${ADK_EXECUTABLE}" VERBATIM)
            set_source_files_properties("${thunk}" PROPERTIES GENERATED TRUE EXTERNAL_OBJECT TRUE)
            target_sources(${target} PRIVATE "${thunk}")
            target_link_options(${target} PRIVATE -Wl,--entry,AnyDevKitEntry -Wl,--subsystem,windows)
            set(preserved "${CMAKE_CURRENT_BINARY_DIR}/${target}-exceptions.txt")
            file(CONFIGURE OUTPUT "${preserved}" CONTENT "__cxa_get_globals\n__cxa_allocate_exception\n__cxa_free_exception\n__cxa_throw\n__cxa_begin_catch\n__cxa_end_catch\n__cxa_rethrow\n__cxa_call_terminate\n__gxx_personality_v0\n_Unwind_Resume\n_ZSt9terminatev\n" NEWLINE_STYLE UNIX)
        else()
            set_target_properties(${target} PROPERTIES BUILD_WITH_INSTALL_RPATH TRUE INSTALL_RPATH "$ORIGIN/libs")
            set(startup "${ADK_ROOT}/share/AnyDevKit/startup/LinuxStartup")
            target_sources(${target} PRIVATE "${startup}/src/Entry.cpp" "${startup}/src/Start.S")
            target_include_directories(${target} PRIVATE "${startup}/include" "${ADK_ROOT}/share/AnyDevKit/startup/include")
            target_link_options(${target} PRIVATE -Wl,--entry,_start -Wl,--as-needed -Wl,--no-undefined -Wl,--disable-new-dtags -Wl,--dynamic-linker,/lib64/ld-linux-x86-64.so.2)
        endif()
        set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${ADK_EXECUTABLE}" "${ADK_ROOT}/lib/cmake/AnyDevKit/Patch.cmake")
        if(preserved)
            set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${preserved}")
        endif()
        add_custom_command(TARGET ${target} POST_BUILD COMMAND "${CMAKE_COMMAND}" "-DADK=${ADK_EXECUTABLE}" "-DINPUT=$<TARGET_FILE:${target}>" "-DTARGET_PLATFORM=${ADK_TARGET}" "-DPRESERVED=${preserved}" -P "${ADK_ROOT}/lib/cmake/AnyDevKit/Patch.cmake" VERBATIM)
    endif()
    set(CMAKE_CXX_STANDARD_LIBRARIES "" PARENT_SCOPE)
endfunction()
function(adk_link_libraries target)
    foreach(library IN LISTS ARGN)
        if(NOT library MATCHES "^lib[A-Za-z0-9_.]+$")
            message(FATAL_ERROR "Invalid runtime library name: ${library}")
        endif()
        if(ADK_TARGET STREQUAL "windows")
            set(import "${ADK_DEPENDENCY_ROOT}/imports/${library}.a")
        else()
            set(import "${ADK_DEPENDENCY_ROOT}/imports/${library}.prx")
        endif()
        if(NOT EXISTS "${import}")
            message(FATAL_ERROR "Missing import library: ${import}")
        endif()
        if(NOT ADK_TARGET STREQUAL "ps5" AND NOT EXISTS "${ADK_DEPENDENCY_ROOT}/runtime/${library}.prx")
            message(FATAL_ERROR "Missing runtime module: ${library}.prx")
        endif()
        target_link_libraries(${target} PRIVATE "${import}")
    endforeach()
    if(ADK_TARGET STREQUAL "windows")
        find_program(ADK_READOBJ NAMES llvm-readobj REQUIRED)
        add_custom_command(TARGET ${target} POST_BUILD COMMAND "${CMAKE_COMMAND}" "-DADK=${ADK_EXECUTABLE}" "-DREADOBJ=${ADK_READOBJ}" "-DEXECUTABLE=$<TARGET_FILE:${target}>" "-DRUNTIME_DIRECTORY=${ADK_DEPENDENCY_ROOT}/runtime" "-DOUTPUT_DIRECTORY=${CMAKE_CURRENT_BINARY_DIR}" -P "${ADK_ROOT}/lib/cmake/AnyDevKit/VerifyRuntimeImports.cmake" VERBATIM)
    endif()
    if(NOT ADK_TARGET STREQUAL "ps5")
        if(NOT IS_DIRECTORY "${ADK_DEPENDENCY_ROOT}/runtime")
            message(FATAL_ERROR "Missing AnyPS5 runtime directory")
        endif()
        set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${ADK_ROOT}/lib/cmake/AnyDevKit/DeployRuntime.cmake")
        add_custom_command(TARGET ${target} POST_BUILD COMMAND "${CMAKE_COMMAND}" "-DREADOBJ=${ADK_READOBJ}" "-DEXECUTABLE=$<TARGET_FILE:${target}>" "-DTARGET_PLATFORM=${ADK_TARGET}" "-DEXTRA_LIBRARIES=$<TARGET_PROPERTY:${target},ADK_RUNTIME_LIBRARIES>" "-DRUNTIME_DIRECTORY=${ADK_DEPENDENCY_ROOT}/runtime" "-DOUTPUT_DIRECTORY=$<TARGET_FILE_DIR:${target}>" -P "${ADK_ROOT}/lib/cmake/AnyDevKit/DeployRuntime.cmake" VERBATIM)
    endif()
endfunction()
function(adk_runtime_libraries target)
    foreach(library IN LISTS ARGN)
        if(NOT library MATCHES "^lib[A-Za-z0-9_.]+$")
            message(FATAL_ERROR "Invalid runtime library name: ${library}")
        endif()
        if(NOT ADK_TARGET STREQUAL "ps5")
            if(NOT EXISTS "${ADK_DEPENDENCY_ROOT}/runtime/${library}.prx")
                message(FATAL_ERROR "Missing runtime module: ${library}.prx")
            endif()
            set_property(TARGET ${target} APPEND PROPERTY ADK_RUNTIME_LIBRARIES "${library}.prx")
            set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${ADK_DEPENDENCY_ROOT}/runtime/${library}.prx")
        endif()
    endforeach()
endfunction()
