set(output "${INPUT}.patched")
if(EXISTS "${output}")
    message(FATAL_ERROR "Previous patch output exists: ${output}")
endif()
set(options --exec)
if(TARGET_PLATFORM STREQUAL "windows")
    list(APPEND options --windows-startup --preserve-export-list "${PRESERVED}")
endif()
execute_process(COMMAND "${ADK}" nid --input "${INPUT}" --output "${output}" ${options} COMMAND_ERROR_IS_FATAL ANY)
file(RENAME "${output}" "${INPUT}")
