set(output "${INPUT}.patched")
if(EXISTS "${output}")
    message(FATAL_ERROR "Previous patch output exists: ${output}")
endif()
set(options --exec)
if(TARGET_PLATFORM STREQUAL "windows")
    execute_process(COMMAND "${OBJCOPY}" --rename-section .eh_fram=.ehfram --rename-section .rdata=.sdkdata,alloc,load,data,contents "${INPUT}" COMMAND_ERROR_IS_FATAL ANY)
    list(APPEND options --preserve-export-list "${PRESERVED}")
endif()
execute_process(COMMAND "${ADK}" nid --input "${INPUT}" --output "${output}" ${options} COMMAND_ERROR_IS_FATAL ANY)
file(RENAME "${output}" "${INPUT}")
