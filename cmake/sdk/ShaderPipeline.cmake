get_filename_component(parent "${DIRECTORY}" DIRECTORY)
file(MAKE_DIRECTORY "${parent}")
if(EXISTS "${DIRECTORY}")
    if(IS_SYMLINK "${DIRECTORY}" OR NOT IS_ABSOLUTE "${DIRECTORY}")
        message(FATAL_ERROR "Invalid pipeline output directory")
    endif()
    foreach(stage IN LISTS STAGES)
        foreach(extension header code adk)
            file(REMOVE "${DIRECTORY}/${stage}.${extension}")
        endforeach()
    endforeach()
    file(GLOB remaining "${DIRECTORY}/*" "${DIRECTORY}/.*")
    if(remaining)
        message(FATAL_ERROR "Pipeline output directory contains unexpected files")
    endif()
    file(REMOVE_RECURSE "${DIRECTORY}")
endif()
execute_process(COMMAND "${ADK}" shader-pipeline --output "${DIRECTORY}" ${OPTIONS} COMMAND_ERROR_IS_FATAL ANY)
