cmake_minimum_required(VERSION 3.22.1)

execute_process(COMMAND "${READOBJ}" --coff-imports "${EXECUTABLE}" OUTPUT_VARIABLE imports COMMAND_ERROR_IS_FATAL ANY)
string(REGEX MATCHALL "Import \\{[^}]*\\}" modules "${imports}")
if(NOT modules)
    message(FATAL_ERROR "Executable has no inspectable imports")
endif()
foreach(module IN LISTS modules)
    string(REGEX MATCH "Name: ([^\r\n]+)" matched "${module}")
    set(library "${CMAKE_MATCH_1}")
    if(NOT library MATCHES "^lib[A-Za-z0-9_.]+\\.prx$" OR NOT EXISTS "${RUNTIME_DIRECTORY}/${library}")
        message(FATAL_ERROR "Import outside AnyPS5 runtime: ${library}")
    endif()
    set(exportList "${OUTPUT_DIRECTORY}/${library}.exports")
    if(DEFINED ADK)
        file(REMOVE "${exportList}")
        execute_process(COMMAND "${ADK}" exports --input "${RUNTIME_DIRECTORY}/${library}" --output "${exportList}" OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
    else()
        execute_process(COMMAND "${NID_PATCHER}" --write-export-list "${RUNTIME_DIRECTORY}/${library}" "${exportList}" OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
    endif()
    file(STRINGS "${exportList}" exports)
    string(REGEX MATCHALL "Symbol: [^ \r\n]+" symbols "${module}")
    if(NOT symbols OR module MATCHES "Ordinal:")
        message(FATAL_ERROR "Unsupported import table for ${library}")
    endif()
    foreach(symbol IN LISTS symbols)
        string(REPLACE "Symbol: " "" symbol "${symbol}")
        if(NOT symbol IN_LIST exports)
            message(FATAL_ERROR "Missing AnyPS5 export: ${library}!${symbol}")
        endif()
    endforeach()
    list(LENGTH symbols symbolCount)
    message(STATUS "Verified ${symbolCount} imports from ${library}")
endforeach()
