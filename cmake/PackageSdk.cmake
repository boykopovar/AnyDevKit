foreach(required BUILD_DIRECTORY PACKAGE_DIRECTORY PACKAGE_NAME ARCHIVE_FORMAT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
set(stage "${PACKAGE_DIRECTORY}/stage")
file(MAKE_DIRECTORY "${PACKAGE_DIRECTORY}")
if(EXISTS "${stage}")
    file(REMOVE_RECURSE "${stage}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIRECTORY}" --component sdk --prefix "${stage}" COMMAND_ERROR_IS_FATAL ANY)
file(GLOB entries RELATIVE "${stage}" "${stage}/*")
if(NOT entries)
    message(FATAL_ERROR "SDK installation is empty")
endif()
set(tarFlags cf)
if(ARCHIVE_FORMAT STREQUAL "gnutar")
    set(tarFlags czf)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar ${tarFlags} "${PACKAGE_DIRECTORY}/${PACKAGE_NAME}" "--format=${ARCHIVE_FORMAT}" -- ${entries} WORKING_DIRECTORY "${stage}" COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "SDK archive: ${PACKAGE_DIRECTORY}/${PACKAGE_NAME}")
