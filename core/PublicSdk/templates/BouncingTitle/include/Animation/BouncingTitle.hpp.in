#include <array>
#include <string_view>

class BouncingTitle final {
public:
    BouncingTitle(std::string_view text, int width, int height);
    void Update(double seconds);
    std::array<float, 2> Position() const;
    float Scale() const;

private:
    std::array<double, 2> position{48, 48};
    std::array<double, 2> velocity{135, 97};
    std::array<double, 2> bounds;
    float scale;
};
